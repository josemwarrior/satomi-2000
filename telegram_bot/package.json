{
  "name": "satomi-telegram-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authenticated Cloudflare Worker gateway from Satomi to a Telegram channel.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260809.1",
    "typescript": "5.9.2",
    "vitest": "3.2.7",
    "wrangler": "4.120.0"
  }
}
