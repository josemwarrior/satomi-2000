{
  "name": "satomi",
  "version": "0.1.0",
  "description": "A safe command-line publisher for a Jekyll microblog and social platforms.",
  "type": "module",
  "bin": {
    "satomi-2000": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "img/header.png",
    "satomi.config.example.yml",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "jekyll",
    "microblog",
    "mastodon",
    "bluesky",
    "x-api",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@atproto/api": "^0.16.11",
    "@atproto/common-web": "^0.4.21",
    "commander": "^14.0.0",
    "dotenv": "^17.2.1",
    "gray-matter": "^4.0.3",
    "twitter-text": "^3.1.0",
    "yaml": "^2.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/twitter-text": "^3.1.7",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
