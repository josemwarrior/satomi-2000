# Copy to .env, run `chmod 600 .env`, and never commit it.
MASTODON_URL=https://mastodon.social
MASTODON_TOKEN=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
X_CLIENT_ID=
# Created and maintained automatically after the first X authorization.
X_REFRESH_TOKEN=
# Separate credential for the Cloudflare Worker. This is not the Telegram bot token.
TELEGRAM_WORKER_TOKEN=
